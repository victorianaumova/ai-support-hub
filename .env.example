# Every setting the system reads (docs/operations.md §2). Copied to .env by `make setup`.
# Never put real keys here; .env is git-ignored. Secrets are left empty on purpose.

# Environment: local | test | demo
APP_ENV=local
# Log level for structlog JSON logs
LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------
# hub:hub and hub_api:hub_api @localhost are local compose defaults only, never real credentials.
# Pooled connection used by the app, as the app role (member of hub_app; cannot change audit_log)
DATABASE_URL=postgresql+psycopg://hub_api:hub_api@localhost:5432/hub
# Direct (not pooled) connection as the migrator (schema owner) for migrations and checkpointer setup; empty = same as DATABASE_URL
DATABASE_URL_DIRECT=postgresql+psycopg://hub:hub@localhost:5432/hub
# Separate database for evaluation runs (app role)
EVAL_DATABASE_URL=postgresql+psycopg://hub_api:hub_api@localhost:5432/hub_eval
# Migrator of the evaluation database (`make migrate`); empty = DATABASE_URL_DIRECT with the database of EVAL_DATABASE_URL
EVAL_DATABASE_URL_DIRECT=

# "Today" for the core mock and the workflow, e.g. 2026-11-12; empty = real date. Fixed in tests and evaluation.
CORE_ANCHOR_DATE=

# Bearer token for POST /admin/jobs/* (random string)
JOBS_TOKEN=
# Retention job (security §6): days without activity before a ticket is deleted, and days after
# the close before its checkpoints are deleted. Empty = 730 and 7.
RETENTION_TICKET_DAYS=
RETENTION_CHECKPOINT_DAYS=

# --- Search ---------------------------------------------------------------
QDRANT_URL=http://localhost:6333
# Empty locally
QDRANT_API_KEY=
# Folder of the local embedding model and BM25 files; `make models` downloads them (ADR-0018)
EMBEDDING_CACHE_DIR=.cache/models

# --- Models ---------------------------------------------------------------
# Read by LiteLLM (only inside hub/llm/gateway.py). One provider only (ADR-0018).
ANTHROPIC_API_KEY=
# real | fake  (fake = deterministic recorded responses; tests need no key)
LLM_MODE=fake
# Roles -> models
MODELS_CONFIG=config/models.yaml
# Prompt files prompts/<node>/v<N>.md (active versions in models.yaml)
PROMPTS_DIR=prompts
# Routing policy and the rule version of confidence (ai-pipeline §6)
POLICY_CONFIG=config/policy.yaml
CONFIDENCE_CONFIG=config/confidence.json

# --- Tools (MCP server) ---------------------------------------------------
# localhost when the API runs on the host; inside compose it is http://mcp:8001/mcp
MCP_SERVER_URL=http://localhost:8001/mcp
MCP_SERVER_TOKEN=

# Only mock: Jira and Slack are mocks inside the MCP server (ADR-0019)
JIRA_MODE=mock
SLACK_MODE=mock

# --- Auth -----------------------------------------------------------------
# Random 32 bytes, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
SESSION_SECRET=
# Access code for the public demo chat
DEMO_ACCESS_CODE=
# Customers shown in the chat picker, with a hint and suggested first messages (P10-02)
DEMO_CUSTOMERS_FILE=data/seed/demo_customers.json
# Password given to seeded operators by `make seed`
SEED_OPERATOR_PASSWORD=

# --- Tracing (off when empty) ---------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Cost control ---------------------------------------------------------
# Start value of the daily budget setting (USD)
DAILY_BUDGET_USD=0.50
# Hard stop for one evaluation run (USD)
EVAL_MAX_COST_USD=1.00
# Folder of the committed evaluation runs; the dashboard's "Last evaluation" box reads the
# newest clean real-model run here (GET /console/evals/latest, P10-09).
EVAL_RUNS_DIR=evals/runs
# Share of evaluation runs sent to Langfuse
EVAL_TRACE_SAMPLE=0.2
